<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorAccent">#043862</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- iOS draws <Text> without a color in black; match it so iOS-designed
             screens don't render uncoloured text in the theme's grey. -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
    </style>
<style name="DatePickerTheme" parent="DatePickerBaseTheme">
    <item name="android:colorControlNormal">#043862</item>
      <item name="colorAccent">#043862</item>
      <item name="android:textSize">25sp</item>
</style>
</resources>
